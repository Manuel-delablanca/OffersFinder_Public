# Copia este archivo a .env (o define las variables como GitHub Secrets para la ejecución automática).

# --- Fuente de precios: Google Shopping (España) vía Serper.dev ---
# Crea una cuenta gratuita en https://serper.dev (2.500 consultas de regalo; después ~1 $ por cada 1.000)
# y pega aquí la clave. Con ella, cada búsqueda devuelve los precios de la mayoría de tiendas españolas.
# Sin clave, el programa consulta a cada tienda del catálogo, pero casi todas bloquean el acceso automático.
SERPER_API_KEY=
# Alternativa con los mismos resultados: https://serpapi.com (100 consultas gratis al mes). Basta con una de las dos claves.
SERPAPI_API_KEY=
# Pausar la API hasta una fecha (AAAA-MM-DD) para reservar consultas; mientras, solo se leen las fichas de producto (url/urls)
API_PAUSE_UNTIL=
# Días de la semana (1 = lunes … 7 = domingo) en los que la pausa no se aplica
API_PAUSE_EXCEPT_WEEKDAYS=1
# auto = Google Shopping si hay clave, tiendas si no | shopping | stores | both
SEARCH_MODE=auto
# Además de Shopping, buscar en Google (web) y leer las páginas de resultados (una consulta más por producto)
WEB_SEARCH=true
WEB_SEARCH_MAX_PAGES=10

# --- Avisos por Telegram (canal principal) ---
# 1) En Telegram, abre @BotFather, envía /newbot, elige nombre y usuario, y copia el token.
# 2) Pega el token abajo, abre tu bot en Telegram y pulsa "Iniciar".
# 3) Ejecuta:  dotnet run --project src/OffersFinder -- telegram-setup   y copia el TELEGRAM_CHAT_ID que muestra.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Email por SMTP (opcional) ---
# Gmail: crea una "contraseña de aplicación" en https://myaccount.google.com/apppasswords
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=
EMAIL_TO=
SMTP_USE_SSL=true

# --- WhatsApp vía CallMeBot (opcional; el bot gratuito suele estar lleno) ---
WHATSAPP_PHONE=
WHATSAPP_APIKEY=

# --- Ajustes generales (opcional) ---
# Porcentaje mínimo de bajada respecto al último precio para avisar (0 = cualquier bajada)
MIN_DROP_PERCENT=0
# Número de ofertas que se incluyen en cada aviso
MAX_OFFERS_IN_ALERT=5
# Rutas de la lista de deseos, el catálogo de tiendas, el histórico y el informe
WATCHLIST_PATH=watchlist.json
STORES_PATH=stores.json
HISTORY_PATH=data/history.json
REPORT_PATH=data/report.html
